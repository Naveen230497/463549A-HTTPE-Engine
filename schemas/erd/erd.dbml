Table users { user_id UUID [pk]; username VARCHAR; email VARCHAR; password_hash VARCHAR; kyc_status VARCHAR; created_at TIMESTAMPTZ; } Table accounts { account_id UUID [pk]; user_id UUID [ref: > users.user_id]; account_type VARCHAR; currency CHAR(3); available_balance NUMERIC; ledger_balance NUMERIC; version BIGINT; status VARCHAR; tier VARCHAR; shard_key INTEGER; created_at TIMESTAMPTZ; updated_at TIMESTAMPTZ; } Table transactions { transaction_id UUID [pk]; idempotency_key VARCHAR; transaction_type VARCHAR; source_account_id UUID [ref: > accounts.account_id]; destination_account_id UUID [ref: > accounts.account_id]; amount NUMERIC; status VARCHAR; saga_id UUID; failure_reason VARCHAR; created_at TIMESTAMPTZ; completed_at TIMESTAMPTZ; metadata JSONB; } Table ledger_entries { entry_id UUID [pk]; transaction_id UUID [ref: > transactions.transaction_id]; account_id UUID [ref: > accounts.account_id]; entry_type VARCHAR; amount NUMERIC; running_balance NUMERIC; created_at TIMESTAMPTZ; } Table transaction_events { event_id UUID [pk]; transaction_id UUID [ref: > transactions.transaction_id]; event_type VARCHAR; payload JSONB; created_at TIMESTAMPTZ; } Table fraud_rules { rule_id UUID [pk]; rule_name VARCHAR; threshold NUMERIC; action VARCHAR; is_active BOOLEAN; created_at TIMESTAMPTZ; } Table merchant_settlements { settlement_id UUID [pk]; merchant_account_id UUID [ref: > accounts.account_id]; total_amount NUMERIC; status VARCHAR; settlement_date DATE; created_at TIMESTAMPTZ; } Table notification_log { log_id UUID [pk]; user_id UUID [ref: > users.user_id]; message TEXT; status VARCHAR; created_at TIMESTAMPTZ; }
